# Railway service
NODE_ENV=production
APP_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app
SESSION_SECRET=GENERATE_A_NEW_LONG_RANDOM_VALUE
ADMIN_EMAIL=YOUR-GOOGLE-ACCOUNT-EMAIL
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_NEW_GOOGLE_CLIENT_SECRET
# Google Programmable Search credentials used by the in-app search dialog.
GOOGLE_SEARCH_API_KEY=YOUR_GOOGLE_SEARCH_API_KEY
GOOGLE_SEARCH_ENGINE_ID=YOUR_GOOGLE_SEARCH_ENGINE_ID

# Reference this value from the Railway MySQL service
DATABASE_URL=${{MySQL.MYSQL_URL}}

# Reference all five values from the Railway Bucket service
S3_ENDPOINT=${{InventoryFiles.ENDPOINT}}
S3_REGION=${{InventoryFiles.REGION}}
S3_BUCKET=${{InventoryFiles.BUCKET}}
S3_ACCESS_KEY_ID=${{InventoryFiles.ACCESS_KEY_ID}}
S3_SECRET_ACCESS_KEY=${{InventoryFiles.SECRET_ACCESS_KEY}}
