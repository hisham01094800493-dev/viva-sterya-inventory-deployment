# Koyeb runtime
NODE_ENV=production
PORT=8000
APP_URL=https://YOUR-KOYEB-DOMAIN
SESSION_SECRET=GENERATE_A_LONG_RANDOM_VALUE
ADMIN_EMAIL=YOUR_GOOGLE_ACCOUNT_EMAIL
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Aiven MySQL — use the values shown in Aiven Console
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=your-aiven-port
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=railway
DB_SSL=true
# Optional: paste the Aiven CA certificate contents as one environment variable.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----...

# Object storage used by the application (keep if file uploads are enabled)
S3_ENDPOINT=https://your-object-storage-endpoint
S3_REGION=your-region
S3_BUCKET=your-bucket
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
