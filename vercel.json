{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "crons": [
    { "path": "/api/scheduled/daily-report-heartbeat", "schedule": "*/5 * * * *" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
